# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais
# antes de publicar o site. Nunca suba o arquivo ".env" para lugar nenhum
# público — ele contém a senha do painel administrativo.

# Acesso ao painel: o jeito mais fácil é abrir /admin.html no próprio computador
# do site — no primeiro acesso ele pede usuário e senha e preenche isto sozinho.
# (Também dá para rodar "python definir_senha.py" nesta pasta.)
# NÃO escreva a senha aqui: fica guardado só o hash Argon2id dela.
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# Segredo que assina as sessões (o definir_senha.py gera um se estiver vazio).
JWT_SECRET=
PORT=5000

# Chave de API do Google Gemini (gere grátis em aistudio.google.com/apikey,
# só com login Google, sem cartão) para o atendente de IA do site.
# Sem ela, o balão de chat mostra um aviso pedindo para configurar, mas o
# resto do site continua funcionando normalmente.
GEMINI_API_KEY=sua-chave-aqui
# Opcional: troque o modelo usado pelo atendente (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Só defina como 1 se houver um proxy (Nginx etc.) na frente do servidor.
# No Render não precisa: é detectado sozinho.
# CONFIAR_NO_PROXY=1
